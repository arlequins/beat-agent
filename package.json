{
  "name": "beat-agent",
  "version": "0.11.2",
  "private": true,
  "engines": {
    "node": "^24.14.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "architecture:check": "node scripts/check-architecture.mjs",
    "preinstall": "node scripts/check-runtime.mjs",
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "storage:start": "docker compose up -d --wait minio && docker compose run --rm minio-init",
    "storage:stop": "docker compose down",
    "dev:local": "pnpm storage:start && pnpm exec dotenv -e .env.localhost -- pnpm dev",
    "agent:setup": "node scripts/setup-local-agent.mjs",
    "agent:readiness": "node scripts/agent-readiness.mjs",
    "agent:demo:check": "node scripts/check-local-agent-demo.mjs",
    "dev:next": "turbo watch dev -F @arlequins/web...",
    "dev:sst": "turbo run sst:dev --continue -F @arlequins/web -F @arlequins/api",
    "check": "biome check .",
    "check:changed": "node scripts/check-changed.mjs",
    "check:fix": "biome check . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "lint:ws": "pnpm dlx sherif@latest",
    "lint:dead-code": "dotenv -e .env.example -- knip",
    "postinstall": "pnpm lint:ws",
    "prepare": "husky",
    "security:licenses": "node scripts/check-licenses.mjs",
    "storybook": "pnpm --filter @arlequins/ui storybook",
    "storybook:build": "pnpm --filter @arlequins/ui build-storybook",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "sst:ws": "node ./scripts/sst-workspace.mjs",
    "test": "pnpm test:runtime && pnpm test:automation && pnpm architecture:check && turbo run test",
    "test:coverage": "dotenv -e .env.example -e .env -- vitest run --coverage --config vitest.coverage.config.ts",
    "test:automation": "node --test scripts/validate-deployment-input.test.mjs",
    "test:sst": "dotenv -e .env.example -e .env -- node scripts/test-sst.mjs",
    "test:runtime": "node --test scripts/check-runtime.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:headed": "node scripts/test-e2e.mjs --headed",
    "env:pull": "pnpm -F @arlequins/sst-bootstrap run env:pull --",
    "env:push": "pnpm -F @arlequins/sst-bootstrap run env:push --",
    "env:check": "node scripts/check-env-sync.mjs",
    "gen:feature": "turbo gen feature"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "catalog:",
    "@turbo/gen": "^2.10.5",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "turbo": "^2.10.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "A local-first personal assistant for Arlequin."
}
